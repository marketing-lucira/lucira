ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DOMAIN=zoho.in
# Actual API name of the "Customer Activities" custom field on Deals.
# Run `npm run discover-fields` after setting the creds above to find it,
# then paste the confirmed api_name here.
CUSTOMER_ACTIVITY_FIELD=Customer_Activities
PORT=3100

# Powers the "Ask AI" tab (/api/chat). Get a free key at
# https://aistudio.google.com/apikey — no separate GCP project needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
