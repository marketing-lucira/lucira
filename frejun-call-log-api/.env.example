# Copy to .env for local testing only. NEVER put the real FreJun API key here —
# it always comes from Secret Manager (secret: frejun-api-key), never from env/code.
GCP_PROJECT=lucirajewelry-prod
BQ_DATASET=frejun_data
BQ_TABLE=frejun_call_log
BQ_STAGING_TABLE=frejun_call_log_stg
BQ_STATE_TABLE=frejun_sync_state

FREJUN_SECRET_NAME=frejun-api-key
FREJUN_BASE_URL=https://api.frejun.com/api/v2
# Required by the FreJun API itself (not a secret) — the FreJun user account
# the API key acts as.
FREJUN_USER_EMAIL=

# Historical load only — leave blank for incremental mode.
START_DATE=
END_DATE=
